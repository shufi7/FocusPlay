<?xml version="1.0" encoding="utf-8"?>
<!-- Tampilan awal SplashActivity sebelum berpindah halaman. -->
<!-- ConstraintLayout dipakai agar background memenuhi layar dan elemen lain mudah diposisikan. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== BAGIAN BACKGROUND ==================== -->
    <!-- Background custom -->
    <!-- Ukuran 0dp dengan constraint ke semua sisi membuat gambar memenuhi layar. -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Background Splash"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ==================== BAGIAN LOGO ==================== -->
    <!-- Logo dihubungkan melalui ivLogoSplash dan diberi animasi di SplashActivity. -->
    <!-- adjustViewBounds menjaga perbandingan gambar logo ketika lebarnya 300dp. -->
    <ImageView
        android:id="@+id/ivLogoSplash"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:adjustViewBounds="true"
        android:src="@drawable/logo_focusplay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ==================== BAGIAN LOADING ==================== -->
    <!-- Ditampilkan selama menunggu splashDelay dan menentukan halaman tujuan. -->
    <!-- Container ditempatkan di bagian bawah layar dengan orientasi vertikal. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="38dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Memberi informasi bahwa aplikasi sedang menyiapkan halaman berikutnya. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand"
            android:gravity="center"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Menyiapkan permainan..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ProgressBar indeterminate menunjukkan proses tanpa persentase tertentu. -->
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
