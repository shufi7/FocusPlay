<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_result_panel"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_result_badge"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Permainan selesai"
            android:textColor="#C77720"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="Hasil Sementara"
            android:textColor="#7A461D"
            android:textSize="31sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Data sudah siap disimpan. Tekan lanjut untuk membuat catatan AI dan membuka halaman hasil lengkap."
            android:textColor="#72563E"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_result_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Skor"
                    android:textColor="#76583F"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvHasilSkor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="0"
                    android:textColor="#24313D"
                    android:textSize="35sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_result_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Akurasi"
                    android:textColor="#76583F"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvHasilAkurasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="0%"
                    android:textColor="#24313D"
                    android:textSize="35sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_result_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Durasi"
                    android:textColor="#76583F"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvHasilDurasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="0 detik"
                    android:textColor="#24313D"
                    android:textSize="27sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_result_stat"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Fase"
                    android:textColor="#76583F"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvHasilFase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="1"
                    android:textColor="#24313D"
                    android:textSize="35sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnSimpanLihatHasil"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_result_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="Simpan &amp; Lihat Hasil"
            android:textColor="#fff"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnKembaliDashboard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_result_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/quicksand_bold"
            android:gravity="center"
            android:text="Kembali ke Dashboard"
            android:textColor="#2462CE"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
