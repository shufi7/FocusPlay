<?xml version="1.0" encoding="utf-8"?>
<!-- Layout PilihAnakActivity untuk memilih profil anak. -->
<!-- ConstraintLayout menjadi root agar header dan kartu utama dapat diatur menggunakan constraint. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/backgrounds">

    <!-- ==================== BAGIAN HEADER ==================== -->
    <!-- LinearLayout horizontal menyusun tombol kembali dan judul dalam satu baris. -->
    <LinearLayout
        android:id="@+id/headerPilihAnak"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol kembali ke halaman sebelumnya melalui finish(). -->
        <!-- Ukuran 46dp, background oranye, dan padding 12dp membentuk tombol ikon. -->
        <ImageView
            android:id="@+id/ivBackPilihAnak"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_back_orange"
            android:contentDescription="Kembali"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <!-- Container berbobot 1 mengisi sisa ruang di samping tombol kembali. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Judul tetap halaman pemilihan profil. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="Pilih Profil Anak"
                android:textColor="#2F2F2F"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ==================== BAGIAN KONTEN UTAMA ==================== -->
    <!-- CardView membungkus seluruh isi dengan sudut bulat dan efek elevasi. -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#FFFBF7"
        app:cardCornerRadius="32dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPilihAnak">

        <!-- Container vertikal menyusun informasi, judul daftar, dan daftar profil. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ==================== BAGIAN INFORMASI HALAMAN ==================== -->
            <!-- Card informasi berwarna lembut sebagai pengantar sebelum memilih profil. -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF1E6"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp">

                <!-- FrameLayout memungkinkan dekorasi lingkaran berada di belakang konten. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Lingkaran dekoratif besar pada sisi kanan. -->
                    <View
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="-45dp"
                        android:background="@drawable/bg_circle_orange_soft" />

                    <!-- Lingkaran dekoratif kecil pada bagian kanan bawah. -->
                    <View
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="48dp"
                        android:layout_marginBottom="-28dp"
                        android:background="@drawable/bg_circle_peach_soft" />

                    <!-- Baris isi kartu: teks di kiri dan gambar karakter di kanan. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="118dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="14dp">

                        <!-- Kolom teks menggunakan weight agar mengambil ruang tersisa. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Kalimat utama pada kartu informasi. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_bold"
                                android:text="Siap bermain hari ini?"
                                android:textColor="#2F2F2F"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Penjelasan tujuan halaman pemilihan profil. -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/quicksand"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:text="Pilih profil anak untuk masuk ke daftar permainan FocusPlay."
                                android:textColor="#7A6B5D"
                                android:textSize="12.5sp" />

                            <!-- Badge kecil untuk konteks latihan fokus. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_badge_orange_soft"
                                android:fontFamily="@font/quicksand_bold"
                                android:gravity="center"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="Latihan fokus anak"
                                android:textColor="#C56A10"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- Gambar karakter dekoratif pada kartu informasi. -->
                        <ImageView
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Karakter"
                            android:scaleType="fitCenter"
                            android:src="@drawable/karakter_anak" />

                    </LinearLayout>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- ==================== BAGIAN JUDUL DAFTAR PROFIL ==================== -->
            <!-- Baris judul yang menjelaskan isi daftar di bawahnya. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Kolom judul dan subjudul daftar profil. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Judul bagian daftar profil. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Daftar Profil"
                        android:textColor="#2F2F2F"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Petunjuk singkat untuk memilih salah satu profil. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Pilih salah satu profil untuk melanjutkan"
                        android:textColor="#7A6B5D"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ==================== BAGIAN DAFTAR PROFIL ANAK ==================== -->
            <!-- Card menggunakan layout_weight=1 agar daftar mengisi sisa tinggi layar. -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#fff1e6"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <!-- ScrollView membuat daftar tetap dapat digulir jika profil banyak. -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="ifContentScrolls"
                    android:padding="12dp"
                    android:scrollbarStyle="outsideOverlay"
                    android:smoothScrollbar="true">

                    <!-- Container vertikal untuk empty state, tombol, dan GridLayout. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Teks berubah sesuai kondisi loading, data kosong, atau gagal. -->
                        <!-- ID tvEmptyState diubah langsung oleh PilihAnakActivity. -->
                        <TextView
                            android:id="@+id/tvEmptyState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_empty_profile_orange"
                            android:fontFamily="@font/quicksand"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:paddingStart="16dp"
                            android:paddingTop="18dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="18dp"
                            android:text="Data anak masih kosong.\nBuat profil anak dulu melalui halaman Orang Tua."
                            android:textColor="#7A6B5D"
                            android:textSize="13sp" />

                        <!-- Membuka halaman Orang Tua jika profil anak masih kosong. -->
                        <!-- visibility awal gone dan hanya ditampilkan saat daftar kosong. -->
                        <TextView
                            android:id="@+id/btnBukaHalamanOrangTua"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_result_primary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand_bold"
                            android:gravity="center"
                            android:text="Buka Halaman Orang Tua"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <!-- Menampung kartu dari item_anak.xml setelah data berhasil diambil. -->
                        <!-- columnCount=2 membuat profil tersusun menjadi dua kolom. -->
                        <GridLayout
                            android:id="@+id/containerProfilAnak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:columnCount="2"
                            android:useDefaultMargins="false"
                            android:alignmentMode="alignBounds" />

                    </LinearLayout>

                </ScrollView>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
