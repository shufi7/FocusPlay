<?xml version="1.0" encoding="utf-8"?>
<!-- Form TambahAnakActivity untuk membuat data baru di "tb_anak". -->
<!-- ConstraintLayout root mengatur posisi header dan card form utama. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/backgrounds">

    <!-- ==================== BAGIAN HEADER ==================== -->
    <!-- Header (Synced with Dashboard) -->
    <!-- Header horizontal berisi tombol kembali dan judul halaman. -->
    <LinearLayout
        android:id="@+id/headerTambahAnak"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol kembali ke halaman sebelumnya melalui finish(). -->
        <!-- Background biru dan padding membentuk tombol ikon yang konsisten. -->
        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_back_blue"
            android:contentDescription="Kembali"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <!-- Container judul mengisi sisa lebar header. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Judul tetap halaman tambah profil anak. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="Tambah Profil Anak"
                android:textColor="#2F2F2F"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- ==================== BAGIAN FORM UTAMA ==================== -->
    <!-- Card Utama (Neutral & Cool Style) -->
    <!-- Card dibatasi ke bawah header dan ke seluruh sisi parent. -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#FFFDFB"
        app:cardCornerRadius="32dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTambahAnak">

        <!-- NestedScrollView menjaga form dapat digulir pada layar kecil. -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- Container vertikal menyusun seluruh elemen form. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- ==================== BAGIAN JUDUL FORM ==================== -->
                <!-- Form Title Section -->
                <!-- Judul utama kelompok data identitas anak. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Identitas Anak"
                    android:textColor="#243447"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Subjudul yang menjelaskan tujuan pengisian form. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand"
                    android:text="Lengkapi data untuk membuat profil baru"
                    android:textColor="#7B8895"
                    android:textSize="12sp" />

                <!-- ==================== BAGIAN INPUT DATA ANAK ==================== -->
                <!-- Nama Anak Input -->
                <!-- Label untuk input nama panggilan. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Nama Panggilan"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <!-- Isi nama disimpan sebagai field "nama_anak". -->
                <!-- inputType textPersonName menampilkan keyboard yang sesuai untuk nama. -->
                <EditText
                    android:id="@+id/etNamaAnak"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_login"
                    android:fontFamily="@font/quicksand_bold"
                    android:hint="Contoh: Budi"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="18dp"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <!-- Usia Anak Input -->
                <!-- Label untuk input usia anak. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Usia (Tahun)"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <!-- Isi umur disimpan sebagai field "usia". -->
                <!-- inputType number membatasi keyboard ke angka. -->
                <EditText
                    android:id="@+id/etUsiaAnak"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_login"
                    android:fontFamily="@font/quicksand_bold"
                    android:hint="Contoh: 7"
                    android:inputType="number"
                    android:paddingHorizontal="18dp"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <!-- ==================== BAGIAN PILIH AVATAR ==================== -->
                <!-- Pilih Avatar Section -->
                <!-- Label bagian pemilihan karakter. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Pilih Karakter"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <!-- HorizontalScrollView memungkinkan seluruh avatar digeser ke samping. -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <!-- Menampung pilihan gambar dari AvatarHelper secara dinamis. -->
                    <!-- Lebar wrap_content mengikuti jumlah avatar yang ditambahkan Activity. -->
                    <LinearLayout
                        android:id="@+id/containerAvatarAnak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- ==================== BAGIAN INFORMASI ==================== -->
                <!-- Info Hint -->
                <!-- Box informasi menjelaskan hasil setelah profil berhasil disimpan. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_info_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Teks informasi profil akan muncul pada daftar pilihan anak. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand"
                        android:text="Setelah disimpan, profil ini akan muncul di daftar pilihan profil anak."
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- ==================== BAGIAN TOMBOL SIMPAN ==================== -->
                <!-- Save Button -->
                <!-- Memvalidasi form lalu menjalankan prosesSimpanAnakFirebase(). -->
                <!-- AppCompatButton menggunakan background hijau dan teks tanpa huruf kapital otomatis. -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSimpanAnak"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_button_green"
                    android:elevation="4dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Simpan Profil Anak"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
