<?xml version="1.0" encoding="utf-8"?>
<!-- Layout GamePasangKartuActivity; kartu permainan dibuat melalui Kotlin. -->
<!-- FrameLayout root memungkinkan background berada di belakang seluruh isi game. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== BAGIAN BACKGROUND ==================== -->
    <!-- centerCrop membuat gambar memenuhi layar tanpa mengubah perbandingan aslinya. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_card" />

    <!-- ==================== BAGIAN HEADER STATUS GAME ==================== -->
    <!-- Header horizontal menampilkan menu, fase, waktu, dan skor. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Membuka menu game dan menjeda timer selama menu tampil. -->
        <!-- Ukuran 52dp dan padding 14dp memberi area sentuh yang cukup. -->
        <ImageView
            android:id="@+id/btnMenuGame"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_menu"
            android:clickable="true"
            android:contentDescription="Menu permainan"
            android:focusable="true"
            android:padding="14dp" />

        <!-- Frame pertama menumpuk background fase dan teks fase. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <!-- Gambar latar indikator fase. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/latar_fase" />

            <!-- Teks fase berubah sesuai hasil dari AdaptiveGameManager. -->
            <!-- Padding start memberi ruang untuk ikon pada gambar latar. -->
            <TextView
                android:id="@+id/tvFase"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:paddingStart="26dp"
                android:paddingEnd="8dp"
                android:text="Fase 1"
                android:textColor="#538004"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Frame kedua menumpuk background waktu dan teks timer. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <!-- Gambar latar indikator waktu. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/latar_waktu" />

            <!-- Menampilkan sisa waktu dari pengaturan permainan. -->
            <!-- Nilai awal 1:00 akan diganti oleh CountDownTimer. -->
            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="8dp"
                android:text="1:00"
                android:textColor="#8B4A16"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Frame ketiga menumpuk background skor dan nilai skor. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <!-- Gambar latar indikator skor. -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/latar_skor" />

            <!-- Nilai skor bertambah saat pasangan kartu ditemukan dengan benar. -->
            <!-- Nilai awal permainan adalah 0. -->
            <TextView
                android:id="@+id/tvSkor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/quicksand_bold"
                android:gravity="center"
                android:paddingStart="26dp"
                android:paddingEnd="8dp"
                android:text="0"
                android:textColor="#2378D7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== BAGIAN PAPAN PERMAINAN ==================== -->
    <!-- Container memenuhi layar dan memusatkan card permainan. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="86dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <!-- CardView menjadi panel utama judul, petunjuk, dan kartu. -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFDF2"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp">

            <!-- Container vertikal menyusun seluruh isi panel permainan. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="16dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp">

                <!-- Judul tetap permainan Pasang Kartu. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_bold"
                    android:gravity="center"
                    android:text="Pasang Kartu"
                    android:textColor="#7A3E18"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <!-- Petunjuk diubah Activity saat preview dan sesi berjalan. -->
                <TextView
                    android:id="@+id/tvPetunjuk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="@font/quicksand"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:text="Ingat letak gambarnya, lalu cocokkan kartu yang sama!"
                    android:textColor="#6B4A2D"
                    android:textSize="14sp" />

                <!-- Garis dekoratif pemisah judul dengan papan kartu. -->
                <View
                    android:layout_width="82dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_line_orange" />

                <!-- Menampung 4, 8, atau 12 kartu sesuai fase. -->
                <!-- Jumlah kolom dan baris diubah melalui aturTampilanFase(). -->
                <GridLayout
                    android:id="@+id/gridKartu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:alignmentMode="alignBounds"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="false" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</FrameLayout>
