<?xml version="1.0" encoding="utf-8"?>
<!-- Layout dashboard untuk profil anak, grafik, recap AI, dan menu. -->
<!-- ConstraintLayout root mengatur posisi header dan card konten Dashboard. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/backgrounds">

    <!-- ==================== BAGIAN HEADER ==================== -->
    <!-- Header horizontal berisi tombol kembali dan judul Dashboard. -->
    <LinearLayout
        android:id="@+id/headerDashboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol kembali menutup Dashboard melalui finish(). -->
        <ImageView
            android:id="@+id/ivBackDashboard"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_back_blue"
            android:contentDescription="Kembali"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <!-- Container judul menggunakan weight untuk mengisi sisa lebar. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Judul tetap Dashboard Pendamping. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="Dashboard Pendamping"
                android:textColor="#2F2F2F"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ==================== BAGIAN KONTEN DASHBOARD ==================== -->
    <!-- Card utama membungkus seluruh isi yang dapat digulir. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDashboardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#FFFDF8"
        app:cardCornerRadius="32dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDashboard">

        <!-- NestedScrollView memungkinkan Dashboard panjang digulir vertikal. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <!-- Container vertikal untuk seluruh bagian Dashboard. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="18dp">

                    <!-- ==================== BAGIAN INFORMASI PENDAMPING ==================== -->
                    <!-- HERO -->
                    <!-- Card pembuka berisi sapaan dan gambar karakter pendamping. -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#EDF6FF"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp">

                        <!-- FrameLayout menumpuk dekorasi lingkaran dan isi kartu. -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Lingkaran dekoratif besar pada sisi kanan. -->
                            <View
                                android:layout_width="150dp"
                                android:layout_height="150dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="-45dp"
                                android:background="@drawable/bg_circle_soft_blue" />

                            <!-- Lingkaran dekoratif kecil pada kanan bawah. -->
                            <View
                                android:layout_width="88dp"
                                android:layout_height="88dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="48dp"
                                android:layout_marginBottom="-28dp"
                                android:background="@drawable/bg_circle_sky_soft" />

                            <!-- Baris utama berisi teks dan gambar karakter. -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="118dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingTop="16dp"
                                android:paddingBottom="16dp"
                                android:paddingStart="18dp"
                                android:paddingEnd="14dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <!-- Sapaan utama untuk pendamping. -->
                                    <TextView
                                        android:id="@+id/tvHeroTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/quicksand_bold"
                                        android:text="Halo, Pendamping!"
                                        android:textColor="#243447"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <!-- Penjelasan fungsi Dashboard. -->
                                    <TextView
                                        android:id="@+id/tvHeroDesc"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="@font/quicksand"
                                        android:lineSpacingExtra="2dp"
                                        android:text="Pilih profil anak untuk melihat grafik, riwayat, dan evaluasi AI."
                                        android:textColor="#6F7D8B"
                                        android:textSize="12.5sp" />

                                    <!-- Badge konteks pemantauan perkembangan. -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:background="@drawable/bg_badge_blue_soft"
                                        android:fontFamily="@font/quicksand_bold"
                                        android:gravity="center"
                                        android:paddingTop="6dp"
                                        android:paddingBottom="6dp"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:text="Pantau perkembangan"
                                        android:textColor="#5E7FE0"
                                        android:textSize="10sp" />

                                </LinearLayout>

                                <!-- Gambar karakter pendamping sebagai dekorasi. -->
                                <ImageView
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    android:adjustViewBounds="true"
                                    android:contentDescription="Karakter"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/karakter_ortu" />

                            </LinearLayout>

                        </FrameLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- ==================== BAGIAN PROFIL ANAK ==================== -->
                    <!-- PROFIL ANAK: menampilkan data "tb_anak" melalui DashboardActivity. -->
                    <!-- Container ini juga menjadi target tutorial profil anak. -->
                    <LinearLayout
                        android:id="@+id/cardProfilAnak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical">

                        <!-- Judul bagian profil anak. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/quicksand_bold"
                            android:text="Profil Anak"
                            android:textColor="#243447"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Petunjuk untuk memilih profil yang akan dipantau. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/quicksand"
                            android:text="Pilih anak yang ingin dipantau"
                            android:textColor="#7B8895"
                            android:textSize="12sp" />

                        <!-- Menampung kartu tambah anak dan profil yang dapat dipilih. -->
                        <!-- HorizontalScrollView memungkinkan kartu digeser ke samping. -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <!-- Kartu profil dibuat langsung oleh DashboardActivity. -->
                            <LinearLayout
                                android:id="@+id/containerProfilAnakDashboard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <!-- Empty state ditampilkan ketika profil belum tersedia. -->
                        <TextView
                            android:id="@+id/tvProfilAnakKosong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_empty_state_blue"
                            android:fontFamily="@font/quicksand"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="Belum ada profil anak.\nTambahkan profil anak terlebih dahulu."
                            android:textColor="#7B8895"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- ==================== BAGIAN GRAFIK PERKEMBANGAN ==================== -->
                    <!-- GRAFIK: menggunakan field akurasi dari "tb_riwayat". -->
                    <!-- Container ini menjadi target tutorial grafik. -->
                    <LinearLayout
                        android:id="@+id/cardGrafikDashboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:orientation="vertical">

                        <!-- Header grafik menyusun judul dan chip dalam satu baris. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <!-- Judul grafik perkembangan. -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/quicksand_bold"
                                    android:text="Grafik Perkembangan"
                                    android:textColor="#243447"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <!-- Penjelasan bahwa nilai merupakan rata-rata akurasi harian. -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/quicksand"
                                    android:text="Rata-rata akurasi dari sesi bermain anak per hari"
                                    android:textColor="#7B8895"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Chip penanda bahwa grafik mengikuti anak terpilih. -->
                            <TextView
                                android:id="@+id/tvChipDataAnak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_blue_soft"
                                android:fontFamily="@font/quicksand_bold"
                                android:paddingStart="14dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="8dp"
                                android:text="Data Anak"
                                android:textColor="#5E7FE0"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Card lembut menjadi latar komponen chart. -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="#F5FAFF"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <!-- LineChart dikonfigurasi dan diisi dari DashboardActivity. -->
                                <!-- Tinggi 290dp menyediakan ruang untuk sumbu dan garis grafik. -->
                                <com.github.mikephil.charting.charts.LineChart
                                    android:id="@+id/chartWeekly"
                                    android:layout_width="match_parent"
                                    android:layout_height="290dp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- ==================== BAGIAN RECAP EVALUASI AI ==================== -->
                    <!-- RECAP AI: menampilkan field "evaluasi_ai" dari "tb_riwayat". -->
                    <!-- Container ini menjadi target tutorial recap AI. -->
                    <LinearLayout
                        android:id="@+id/cardRecapAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:orientation="vertical">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Judul bagian recap evaluasi. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_bold"
                                android:text="Recap Evaluasi AI"
                                android:textColor="#243447"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <!-- Penjelasan singkat isi feedback permainan. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand"
                                android:text="Feedback permainan untuk pendamping"
                                android:textColor="#7B8895"
                                android:textSize="12sp" />

                            <!-- Petunjuk bahwa kartu evaluasi dapat digeser horizontal. -->
                            <TextView
                                android:id="@+id/tvHintSwipeAi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_chip_blue_soft"
                                android:fontFamily="@font/quicksand"
                                android:paddingStart="14dp"
                                android:paddingTop="7dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="7dp"
                                android:text="Geser ke kanan untuk melihat semua evaluasi →"
                                android:textColor="#5E7FE0"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Card membungkus empty state dan daftar recap. -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="#F5FAFF"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <!-- Empty state tampil jika evaluasi AI belum ada. -->
                                <TextView
                                    android:id="@+id/tvAiRecapKosong"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_empty_state_blue"
                                    android:fontFamily="@font/quicksand"
                                    android:gravity="center"
                                    android:padding="16dp"
                                    android:text="Belum ada evaluasi AI.\nEvaluasi akan muncul setelah anak menyelesaikan permainan."
                                    android:textColor="#7B8895"
                                    android:textSize="12sp" />

                                <!-- Scroll horizontal untuk melihat seluruh kartu evaluasi. -->
                                <HorizontalScrollView
                                    android:id="@+id/scrollAiRecap"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:overScrollMode="never"
                                    android:scrollbars="none">

                                    <!-- Kartu recap ditambahkan melalui tambahCardRecapAi(). -->
                                    <LinearLayout
                                        android:id="@+id/containerAiRecap"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal" />
                                </HorizontalScrollView>

                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- ==================== BAGIAN MENU PENDAMPING ==================== -->
                    <!-- MENU -->
                    <!-- Container menu berisi Riwayat, Pengaturan, dan Logout. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:orientation="vertical">

                        <!-- Judul kelompok menu pendamping. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/quicksand_bold"
                            android:text="Menu Pendamping"
                            android:textColor="#243447"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Baris membagi ruang untuk dua kartu menu. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <!-- Membuka halaman riwayat sambil membawa ID anak. -->
                            <!-- layout_weight=1 membagi lebar sama rata. -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnRiwayatPermainan"
                                android:layout_width="0dp"
                                android:layout_height="118dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#F6FAFF"
                                app:cardCornerRadius="22dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <!-- Ikon menu riwayat. -->
                                    <ImageView
                                        android:layout_width="64dp"
                                        android:layout_height="64dp"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="Riwayat"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/icon_riwayat" />

                                    <!-- Label menu Riwayat. -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:fontFamily="@font/quicksand_bold"
                                        android:text="Riwayat"
                                        android:textColor="#243447"
                                        android:textSize="14sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Membuka PengaturanPermainanActivity. -->
                            <!-- Kartu kedua memiliki ukuran sama dengan kartu Riwayat. -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnPengaturanPermainan"
                                android:layout_width="0dp"
                                android:layout_height="118dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#F6FAFF"
                                app:cardCornerRadius="22dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <!-- Ikon menu pengaturan. -->
                                    <ImageView
                                        android:layout_width="64dp"
                                        android:layout_height="64dp"
                                        android:adjustViewBounds="true"
                                        android:contentDescription="Pengaturan"
                                        android:scaleType="fitCenter"
                                        android:src="@drawable/icon_setting" />

                                    <!-- Label menu Pengaturan. -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:fontFamily="@font/quicksand_bold"
                                        android:text="Pengaturan"
                                        android:textColor="#243447"
                                        android:textSize="14sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <!-- Membersihkan sesi lalu berpindah ke AuthChoiceActivity. -->
                        <!-- Gambar btn_logout berfungsi sebagai tombol logout penuh. -->
                        <ImageView
                            android:id="@+id/btnLogout"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:src="@drawable/btn_logout"
                            android:layout_marginTop="14dp"
                            android:adjustViewBounds="true"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>


            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
