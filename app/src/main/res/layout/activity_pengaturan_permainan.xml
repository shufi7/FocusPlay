<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/backgrounds">

    <!-- Header (Synced with Dashboard/Tambah Anak) -->
    <LinearLayout
        android:id="@+id/headerPengaturan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBackPengaturan"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_back_blue"
            android:contentDescription="Kembali"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_bold"
                android:text="Pengaturan Permainan"
                android:textColor="#2F2F2F"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Main Container Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="#FFFDFB"
        app:cardCornerRadius="32dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerPengaturan">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- HERO / INFO CARD (Green Design with Character) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F1F8E9"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#C5E1A5"
                    app:strokeWidth="1.5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- Organic Circles (Synced with Dashboard style) -->
                        <View
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="-45dp"
                            android:background="@drawable/bg_circle_soft_green"
                            android:alpha="0.5" />

                        <View
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_gravity="end|bottom"
                            android:layout_marginEnd="48dp"
                            android:layout_marginBottom="-28dp"
                            android:background="@drawable/bg_circle_soft_green"
                            android:alpha="0.3" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/quicksand_bold"
                                    android:text="Mekanisme Fase"
                                    android:textColor="#2E7D32"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/quicksand"
                                    android:lineSpacingExtra="3dp"
                                    android:text="Permainan dimulai dari Fase 1. Jika mode adaptif aktif, fase akan naik atau turun otomatis sesuai performa anak."
                                    android:textColor="#4E6B4F"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginStart="14dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/karakter_bengkel" />

                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SECTION: CONFIGURATION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:fontFamily="@font/quicksand_bold"
                    android:text="Konfigurasi Bermain"
                    android:textColor="#243447"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- INPUT: TARGET WAKTU -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/quicksand"
                    android:text="Target Waktu (Menit)"
                    android:textColor="#4B5563"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etTargetWaktu"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_green"
                    android:fontFamily="@font/quicksand"
                    android:hint="Contoh: 15"
                    android:inputType="number"
                    android:paddingHorizontal="18dp"
                    android:textColor="#1F2937"
                    android:textColorHint="#9CA3AF"
                    android:textSize="14sp" />

                <!-- SWITCH: MODE ADAPTIF (Green Theme) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="#F1F8E9"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_bold"
                                android:text="Mode Adaptif"
                                android:textColor="#2E7D32"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand"
                                android:text="Benar 5x naik fase, salah 3x turun"
                                android:textColor="#4E6B4F"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchAdaptif"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#8DB52A"
                            android:trackTint="#C5E1A5" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- INFO HINT (Green Theme) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_info_green"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand"
                        android:text="Pengaturan ini akan langsung diterapkan untuk semua permainan di profil anak."
                        android:textColor="#4E6B4F"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- SAVE BUTTON -->
                <ImageView
                    android:id="@+id/btnSimpanPengaturan"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:clickable="true"
                    android:contentDescription="Simpan Konfigurasi"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/btn_simpan" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
